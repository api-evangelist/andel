          "name": "List purchases",
          "request": {
            "name": "List purchases",
            "description": {
              "content": "List purchases visible to the authenticated tenant, ordered by\n`purchased_at` descending. Use cursor pagination via `since` and `limit`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "purchases"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "member_id",
                  "value": "<string>",
                  "description": "Filter purchases to a single member."
                },
                {
                  "disabled": false,
                  "key": "plan_id",
                  "value": "<string>",
                  "description": "Filter purchases to a single plan. Must be one of the plans the token is authorized for; otherwise the API returns `403 Forbidden`."
                },
                {
                  "disabled": false,
                  "key": "ndc",
                  "value": "<string>",
                  "description": "Filter to a single NDC-11 drug code."
                },
                {
                  "disabled": false,
                  "key": "prescriber_spi",
                  "value": "<string>",
                  "description": "Filter to purchases written by a specific prescriber (Surescripts SPI)."
                },
                {
                  "disabled": false,
                  "key": "event_type",
                  "value": "<string>",
                  "description": "Filter purchases to a single event type (e.g., only reversals)."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter purchases by processing status (e.g., only rejected)."
                },
                {
                  "disabled": false,
                  "key": "since",
                  "value": "<string>",
                  "description": "Cursor or ISO 8601 UTC timestamp. Returns purchases after this point."
                },
                {
                  "disabled": false,
                  "key": "until",
                  "value": "<dateTime>",
                  "description": "ISO 8601 UTC timestamp upper bound (exclusive)."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Max results per page."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
